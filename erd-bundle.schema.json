{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent_er_spec/erd-bundle.schema.json",
  "title": "ER Canvas Bundle",
  "description": "Agent 將 MD / SQL / 設計稿整理後應輸出此結構；可由宿主頁轉為 LAYERS、TABLES、各圖之 canvas/positions/connections 等常數。",
  "type": "object",
  "required": ["meta", "layers", "tables", "diagrams"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string" },
        "version": { "type": "string" },
        "locale": { "type": "string", "default": "zh-Hant" },
        "notes": { "type": "string" }
      }
    },
    "constants": {
      "type": "object",
      "description": "表卡寬高（像素）；省略時宿主可使用預設 214 / 172",
      "additionalProperties": false,
      "properties": {
        "cardW": { "type": "number", "minimum": 80 },
        "cardHApprox": { "type": "number", "minimum": 80 }
      }
    },
    "layers": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label", "color", "bg", "border"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string" },
          "color": { "type": "string" },
          "bg": { "type": "string" },
          "border": { "type": "string" }
        }
      }
    },
    "tables": {
      "type": "object",
      "minProperties": 1,
      "description": "鍵為資料表邏輯名稱（snake_case）；宿主頁通常對應為 TABLES 物件",
      "additionalProperties": {
        "type": "object",
        "required": ["layer", "status", "cols"],
        "additionalProperties": false,
        "properties": {
          "layer": { "type": "string", "description": "必須為 layers 的 key" },
          "status": {
            "type": "string",
            "enum": ["existing", "new", "future"]
          },
          "section": { "type": "string" },
          "comment": { "type": "string" },
          "cols": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "type"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "tag": { "type": "string", "enum": ["PK", "FK", "UQ"] },
                "ref": { "type": "string", "description": "FK 時指向的表名" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "diagrams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "canvas", "positions", "connections"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "description": "對應 ERDiagram 的 diagId；會寫入 localStorage erd-pos-{id}"
          },
          "label": { "type": "string" },
          "canvas": {
            "type": "object",
            "required": ["w", "h"],
            "additionalProperties": false,
            "properties": {
              "w": { "type": "number", "minimum": 200 },
              "h": { "type": "number", "minimum": 200 }
            }
          },
          "positions": {
            "type": "object",
            "description": "表名 → 卡片中心座標 { cx, cy }（像素）",
            "additionalProperties": {
              "type": "object",
              "required": ["cx", "cy"],
              "additionalProperties": false,
              "properties": {
                "cx": { "type": "number" },
                "cy": { "type": "number" }
              }
            }
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to", "label"],
              "additionalProperties": false,
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "label": { "type": "string", "description": "線上顯示的 FK 欄位或語意標籤" },
                "isNew": { "type": "boolean" },
                "dashed": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "dataFlows": {
      "type": "array",
      "description": "選填；對應 DATA_FLOWS（§13 類流程卡）",
      "items": {
        "type": "object",
        "required": ["id", "title", "steps"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "tag": { "type": "string" },
          "tagColor": { "type": "string" },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["actor", "action"],
              "properties": {
                "actor": { "type": "string" },
                "action": { "type": "string" }
              }
            }
          },
          "writes": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "designDecisions": {
      "type": "array",
      "description": "選填；對應 DESIGN_DECISIONS 對照卡",
      "items": {
        "type": "object",
        "required": ["title", "old", "v3"],
        "additionalProperties": true,
        "properties": {
          "title": { "type": "string" },
          "old": { "type": "string" },
          "v3": { "type": "string" },
          "highlight": { "type": "boolean" }
        }
      }
    }
  }
}
